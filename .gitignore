.DS_Store
Thumbs.db
*.tmp

# This is a VPM *package*, not a Unity project — no Library/, Temp/, etc.
# Asset .meta files ARE tracked (they carry stable GUIDs).

# The gate's log lives in the workspace's test-output/, never in this tree — anything on disk here is
# an asset to a venue that mounts this package, and a file written during a run import-loops.

# Python bytecode from the entry generators
__pycache__/

# Unity generates .meta for the generators' bytecode dirs; the dirs themselves are ignored above
__pycache__.meta
